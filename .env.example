# =============================================================
# VulnScan Pro — Environment Template
# =============================================================
# Copy this file to `.env` and fill in YOUR actual paths.
# Run `python config.py` after editing to verify.
# =============================================================

# --- Flask ---
SECRET_KEY=generate-a-long-random-string-here
FLASK_DEBUG=0
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# --- Database ---
VULNSCAN_DB=database.db

# --- External tools (network) ---
NMAP_PATH=C:\Program Files (x86)\Nmap\nmap.exe

# --- External tools (web) ---
NUCLEI_PATH=C:\Users\YOURNAME\go\bin\nuclei.exe
WHATWEB_PATH=C:\Users\YOURNAME\Downloads\whatweb\whatweb
DNSENUM_PATH=C:\Users\YOURNAME\Downloads\dnsenum\dnsenum.pl
RUBY_PATH=C:\Ruby40-x64\bin\ruby.exe
PERL_PATH=C:\Users\YOURNAME\Downloads\Strawberry\perl\bin\perl.exe

# --- DAST tools (advanced XSS / SQLi / fuzzing) ---
# Dalfox — install via: choco install dalfox
# Leave blank if `dalfox` is on PATH (config.py falls back to shutil.which)
# DALFOX_PATH=C:\ProgramData\chocolatey\bin\dalfox.exe

# SQLMap — extract the release to a folder, point to sqlmap.py
# REQUIRED for the "SQL Injection Scan" profile to work
SQLMAP_PATH=C:\Tools\sqlmap\sqlmap.py

# Python interpreter — used to run sqlmap.py
# Leave blank if `python` works on PATH
# PYTHON_PATH=C:\Python312\python.exe

# --- Scan timeouts (seconds) ---
SCAN_TIMEOUT_NMAP=900
SCAN_TIMEOUT_NUCLEI=600
SCAN_TIMEOUT_WHATWEB=180
SCAN_TIMEOUT_DNSENUM=120
SCAN_TIMEOUT_DALFOX=300
SCAN_TIMEOUT_SQLMAP=600